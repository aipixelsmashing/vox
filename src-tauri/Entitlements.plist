<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Microphone capture -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Required by the WebView's JIT -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- com.apple.security.cs.disable-library-validation was for the ONNX Runtime dylib.
         v1 ships no ONNX runtime (docs/adr/0016), so it is not requested. -->
</dict>
</plist>
